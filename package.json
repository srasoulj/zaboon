{
  "name": "zaboon",
  "private": true,
  "description": "Zaboon: a Duolingo-style web app that teaches Persian (Farsi) to English speakers",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm db:ensure && AUTH_MODE=local NEXT_PUBLIC_AUTH_MODE=local ZABOON_DEV_AUTH=1 pnpm --filter @zaboon/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project dom --passWithNoTests",
    "test:db": "pnpm db:ensure && vitest run --project db --passWithNoTests",
    "test:watch": "vitest --project unit",
    "e2e": "playwright test",
    "db:ensure": "bash scripts/db-local.sh ensure",
    "db:stop": "bash scripts/db-local.sh stop",
    "db:status": "bash scripts/db-local.sh status",
    "db:migrate": "tsx scripts/migrate.ts",
    "content": "pnpm --filter @zaboon/content-cli run cli",
    "ownership": "tsx scripts/check-ownership.ts",
    "secrets:scan": "bash scripts/secret-scan.sh",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "postgres": "3.4.9",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
