# Zaboon environment variables: NAMES ONLY. Never commit real values.
# Copy to .env.local (git-ignored) for local development.
# See docs/ARCHITECTURE.md §11 (AI) and §13 (secrets matrix), and docs/DEPLOY.md §5.2 (what each
# one does in production, and which are required).

# --- Browser (public by design; NEXT_PUBLIC_ prefix) ---
# Canonical origin, e.g. https://zaboon.app (metadata, sitemap, robots.txt)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=           # not read yet: Turnstile isn't wired (DEPLOY.md §3.1)
NEXT_PUBLIC_SENTRY_DSN=                   # not read yet: no Sentry code
NEXT_PUBLIC_AMPLITUDE_API_KEY=            # not read yet: no Amplitude code
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=          # P2: Web Push (deferred)

# --- Server only (Vercel). Never add a NEXT_PUBLIC_ prefix to these. ---
SUPABASE_SECRET_KEY=
DATABASE_URL_APP_SERVER=                  # app_server role via the Supavisor transaction pooler
TURNSTILE_SECRET_KEY=                     # not read yet: Turnstile isn't wired
CRON_SECRET=
APP_SIGNING_SECRET=                       # P2 speak: HMAC key for signed transcript tokens, at least 32 random characters; local mode has a dev default
EMAIL_API_KEY=                            # not read yet: auth email goes through Supabase's SMTP settings
OPENROUTER_API_KEY_APP=                   # P2 speak: runtime AI (speech transcription); give it its own credit limit
ZABOON_TRUST_PROXY=                       # self-hosting only: 1 behind a proxy that overwrites X-Forwarded-For (per-IP rate limits); Vercel is detected
# STRIPE_SECRET_KEY=                      # P2 (deferred)
# STRIPE_WEBHOOK_SECRET=                  # P2 (deferred)
# VAPID_PRIVATE_KEY=                      # P2 (deferred)

# --- Content (a public URL, not a secret; needed at build time and at runtime) ---
# Where published course content lives, e.g. https://<project>.supabase.co/storage/v1/object/public/content
# The server fetches bundles and builds media URLs from it; next.config.ts inlines it for the
# browser as NEXT_PUBLIC_CONTENT_BASE_URL. Unset locally (apps/web/public/content, same origin).
CONTENT_BASE_URL=

# --- Content pipeline only (content CI + local dev). Never deployed to Vercel. ---
OPENROUTER_API_KEY_BUILD=                 # content-cli: draft, suggest, art, tts; its own credit limit
SUPABASE_URL=                             # content-cli publish: the Supabase project URL (storage upload)
CONTENT_STORAGE_UPLOAD_KEY=               # content-cli publish: a key allowed to write to the content bucket

# --- Local development and tests only. NEVER set these in Production or Preview (DEPLOY.md §5.3). ---
# AUTH_MODE=local                         # dev auth (HS256, x-test-now, x-test-flags); refuses to run on Vercel
# NEXT_PUBLIC_AUTH_MODE=local             # build time: the browser signs in through /api/dev/auth/*
# ZABOON_DEV_AUTH=1                       # build time: compiles the *.dev.ts routes
# ZABOON_DEV_AUTH_SECRET=                 # optional: the local HS256 secret (default: .local/dev-auth-secret)
# ZABOON_CONTENT_DIR=                     # optional: where local content bundles are read from
# ZABOON_DB_PORT=54322                    # local Postgres (scripts/db-local.sh)
# ZABOON_DB_NAME=zaboon
# ZABOON_E2E_PORT=3100                    # the Playwright dev server
