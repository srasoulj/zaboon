# Zaboon environment variables: NAMES ONLY. Never commit real values.
# Copy to .env.local (git-ignored) for local development.
# See docs/ARCHITECTURE.md §11 (AI) and §13 (secrets matrix); docs/DEPLOY.md §5.2 for Vercel.

# --- Browser (public by design; NEXT_PUBLIC_ prefix) ---
# Canonical origin, e.g. https://zaboon.app (metadata, sitemap, robots.txt)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_AMPLITUDE_API_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=          # P2: Web Push

# --- Server only (Vercel). Never add a NEXT_PUBLIC_ prefix to these. ---
SUPABASE_SECRET_KEY=                      # runtime: Auth admin API; build: uploads published content (scripts/release.ts)
DATABASE_URL_APP_SERVER=                  # app_server role via the Supavisor transaction pooler
DATABASE_URL_MIGRATE=                     # Production only, build time: postgres role via the session pooler; the build applies migrations and publishes content with it (scripts/release.ts)
TURNSTILE_SECRET_KEY=
CRON_SECRET=
APP_SIGNING_SECRET=                       # P2: HMAC key for signed tokens (speak transcripts), at least 32 random characters; local mode has a dev default
EMAIL_API_KEY=
OPENROUTER_API_KEY_APP=                   # P2+: runtime AI (speak transcription, explain, roleplay); its own credit limit
ZABOON_TRUST_PROXY=                       # self-hosting only: 1 behind a proxy that overwrites X-Forwarded-For (per-IP rate limits); Vercel is detected
# STRIPE_SECRET_KEY=                      # P2
# STRIPE_WEBHOOK_SECRET=                  # P2
# VAPID_PRIVATE_KEY=                      # P2

# --- Content (a public URL, not a secret; build time and runtime) ---
# Where published course content lives. Optional: unset, it is derived from NEXT_PUBLIC_SUPABASE_URL
# as <url>/storage/v1/object/public/content, the bucket the release publishes to (apps/web/lib/content-base-url.ts).
# Set it only for content hosted elsewhere. next.config.ts inlines it for the browser as
# NEXT_PUBLIC_CONTENT_BASE_URL. Unset locally without a Supabase URL: apps/web/public/content, same origin.
CONTENT_BASE_URL=

# --- Content pipeline only (content CI + local dev). Never deployed to Vercel. ---
OPENROUTER_API_KEY_BUILD=                 # content-cli: draft, suggest, art, tts; its own credit limit
SUPABASE_URL=                             # publish --target storage by hand: the project URL (the release uses NEXT_PUBLIC_SUPABASE_URL)
CONTENT_STORAGE_UPLOAD_KEY=               # publish --target storage by hand: write access to the bucket (the release uses SUPABASE_SECRET_KEY)
